# ---- Database ----
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/doraha_eats?schema=public"

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,http://localhost:19006"

# ---- Auth ----
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- Local dev demo accounts (NEVER use in production) ----
DEMO_PASSWORD="Doraha@123"
SEED_DEMO_DATA=true

# ---- Adapters: all default to safe local mocks ----
PAYMENT_PROVIDER=mock          # mock | razorpay
SMS_PROVIDER=console           # console | msg91
PUSH_PROVIDER=inapp            # inapp | expo | fcm
STORAGE_PROVIDER=local         # local | s3 | cloudinary
MAPS_PROVIDER=manual           # manual | osm | google

# ---- Auth ----
GOOGLE_CLIENT_IDS=             # comma-separated Web/Android/iOS OAuth client ids
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Optional third-party keys. The MVP runs fully WITHOUT these. ----
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=       # set the same value in Razorpay Dashboard > Webhooks
PAYMENT_WINDOW_MINUTES=30      # unpaid online orders are auto-cancelled after this
UPI_VPA="dorahaeats@demoupi"

# ---- PRODUCTION (NODE_ENV=production) refuses to start unless ----
#   PAYMENT_PROVIDER=razorpay + RAZORPAY_KEY_ID/KEY_SECRET/WEBHOOK_SECRET are set
#   CORS_ORIGINS lists explicit https origins (no "*")
#   JWT_SECRET is 32+ random characters
#   SEED_DEMO_DATA=false and DEMO_PASSWORD is changed
#   SMS_PROVIDER is not "console" and STORAGE_PROVIDER is not "local"

# Reverse proxies in front of the API (Render/Railway/Nginx = 1). Affects rate limiting.
TRUST_PROXY=1

# ---- Images (STORAGE_PROVIDER=s3 for production; works with AWS S3, Cloudflare R2, Backblaze B2, DO Spaces) ----
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                   # empty for AWS S3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=            # e.g. https://cdn.yourdomain.com

# ---- Push (PUSH_PROVIDER=expo for production) ----
EXPO_ACCESS_TOKEN=
