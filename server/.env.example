# ---- Database ----
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/doraha_eats?schema=public"

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,http://localhost:19006"

# ---- Auth ----
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- Local dev demo accounts (NEVER use in production) ----
DEMO_PASSWORD="Doraha@123"
SEED_DEMO_DATA=true

# ---- Adapters: all default to safe local mocks ----
PAYMENT_PROVIDER=mock          # mock | razorpay
SMS_PROVIDER=console           # console | msg91   (console = OTP login DISABLED in production)
PUSH_PROVIDER=inapp            # inapp | expo | fcm
STORAGE_PROVIDER=local         # local | s3 | cloudinary
MAPS_PROVIDER=manual           # manual | osm | google

# ---- Optional third-party keys. The MVP runs fully WITHOUT these. ----
GOOGLE_MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_VPA="dorahaeats@demoupi"

# ---- Required only when SMS_PROVIDER=msg91 (needs India DLT-approved template) ----
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- PRODUCTION ONLY (server refuses to start if these are unsafe) ----
# NODE_ENV=production
# CORS_ORIGINS=https://admin.yourdomain.com
# JWT_SECRET=<48+ random chars>   -> node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SEED_DEMO_DATA=false
# DEMO_PASSWORD=<anything not "Doraha@123">
# UPI_VPA=<your real UPI ID>
